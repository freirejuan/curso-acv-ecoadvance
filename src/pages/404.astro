---
import Base from '../layouts/Base.astro';
---
<Base
  title="Página no encontrada · Curso Virtual de ACV"
  description="La página que buscas no existe."
>
  <section class="section">
    <div class="container" style="text-align:center; padding-top:40px; padding-bottom:40px">
      <p class="kicker kicker-center">Error 404</p>
      <h1 style="font-size:2.4rem">Página no encontrada</h1>
      <p style="max-width:46ch; margin:0 auto 28px">
        La página que buscas no existe o ha cambiado de dirección.
      </p>
      <a class="btn btn-primary" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>
