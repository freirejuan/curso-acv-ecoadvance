---
import Base from '../../layouts/Base.astro';
import TarjetaVideo from '../../components/TarjetaVideo.astro';
import TarjetaCurso from '../../components/TarjetaCurso.astro';
import GrupoReferencias from '../../components/GrupoReferencias.astro';
import TarjetaRecurso from '../../components/TarjetaRecurso.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const modulos = await getCollection('modulos');
  return modulos.map((m) => ({
    params: { slug: m.data.slug },
    props: { modulo: m },
  }));
}

const { modulo } = Astro.props;
const d = modulo.data;

const todos = (await getCollection('modulos')).sort(
  (a, b) => a.data.numero - b.data.numero
);
const anterior = todos.find((m) => m.data.numero === d.numero - 1);
const siguiente = todos.find((m) => m.data.numero === d.numero + 1);

const hayInspirarte = d.inspirarte.length > 0;
const hayCursos = d.cursos.length > 0;
const hayReferencias = d.referencias.length > 0;
---
<Base
  title={`Módulo ${d.numero} — ${d.titulo} · Curso Virtual de ACV`}
  description={`${d.subtitulo}. Módulo ${d.numero} del Curso Virtual de Análisis de Ciclo de Vida — EcoAdvance Ecuador.`}
  current="modulo"
>
  <section class="hero page-header">
    <div class="container on-dark">
      <p class="breadcrumb"><a href="/#programa">← Volver al programa</a></p>
      <div class="badges">
        <span class="badge badge-mod">Módulo {d.numero} de 5</span>
        <span class="badge badge-fecha">📅 {d.fechas}</span>
        <span class="badge badge-fecha">{d.sesiones}</span>
      </div>
      <h1>{d.titulo}</h1>
      <p class="sub">{d.subtitulo}</p>
    </div>
  </section>

  <section class="section" style="padding-bottom:56px" id="contenidos">
    <div class="container">
      <nav class="subnav" aria-label="Secciones del módulo">
        <a href="#contenidos">Contenidos</a>
        {hayInspirarte && <a href="#inspirarte">Para inspirarte</a>}
        {(hayCursos || hayReferencias) && <a href="#profundizar">Para profundizar</a>}
        <a href="#presentaciones">Presentaciones</a>
      </nav>

      <p class="kicker">Sobre este módulo</p>
      <div class="prose">
        <p>{d.descripcion}</p>
      </div>
      <h2 style="font-size:1.375rem; margin-top:36px">Contenidos</h2>
      <ul class="lista-tema">
        {d.contenidos.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-tint" style="padding-top:64px; padding-bottom:64px">
    <div class="container">
      <p class="kicker">Materiales</p>

      {hayInspirarte && (
        <div id="inspirarte">
          <h2>Para inspirarte</h2>
          <p class="resumen-seccion">
            Vídeos y píldoras breves para abrir la mirada antes de la sesión.
            {d.resumen_inspirarte && <strong> {d.resumen_inspirarte}</strong>}
          </p>
          {d.inspirarte.map((item) => <TarjetaVideo item={item} />)}
        </div>
      )}

      {(hayCursos || hayReferencias) && (
        <div id="profundizar">
          <h2 style={hayInspirarte ? 'margin-top:64px' : ''}>Para profundizar</h2>
          <p class="resumen-seccion">
            Cursos e-learning y referencias para seguir aprendiendo a tu ritmo.
          </p>

          {hayCursos && (
            <>
              <h3 style="margin-top:32px; margin-bottom:6px">Cursos</h3>
              {d.resumen_cursos && (
                <p class="resumen-seccion" style="font-size:.9375rem"><strong>{d.resumen_cursos}</strong></p>
              )}
              <div style="margin-top:18px">
                {d.cursos.map((item) => <TarjetaCurso item={item} />)}
              </div>
            </>
          )}

          {hayReferencias && (
            <>
              <h3 style="margin-top:40px; margin-bottom:6px">Referencias relevantes</h3>
              <p class="resumen-seccion" style="font-size:.9375rem; margin-bottom:18px">
                Informes, guías y entidades de referencia, como materiales de consulta.
              </p>
              {d.referencias.map((g) => (
                <GrupoReferencias titulo={g.titulo} plegable={g.plegable} items={g.items} />
              ))}
            </>
          )}
        </div>
      )}

      <div id="presentaciones">
        <h2 style="margin-top:64px">Presentaciones</h2>
        {d.nota_presentaciones && (
          <p class="resumen-seccion" style="margin-bottom:18px">{d.nota_presentaciones}</p>
        )}
        {d.presentaciones.length > 0
          ? d.presentaciones.map((r, i) => <TarjetaRecurso recurso={r} numero={i + 1} />)
          : <Placeholder tipo="presentaciones" />}
      </div>
    </div>
  </section>

  <section class="container">
    <nav class="mod-nav" aria-label="Navegación entre módulos" style="border-top:none; margin-top:0; padding-top:36px; padding-bottom:64px">
      <div>
        {anterior && (
          <a href={`/modulos/${anterior.data.slug}/`}>
            <span class="dir">← Módulo anterior</span>
            {anterior.data.titulo}
          </a>
        )}
      </div>
      <div style="text-align:right">
        {siguiente && (
          <a href={`/modulos/${siguiente.data.slug}/`}>
            <span class="dir">Módulo siguiente →</span>
            {siguiente.data.titulo}
          </a>
        )}
      </div>
    </nav>
  </section>
</Base>
