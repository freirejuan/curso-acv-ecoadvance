---
interface Recurso {
  titulo: string;
  tipo: 'pdf' | 'enlace' | 'video' | 'presentacion';
  fuente?: string;
  descripcion?: string;
  porque?: string;
  url?: string;
  estado: 'disponible' | 'proximamente';
}
interface Props {
  recurso: Recurso;
  numero: number;
}
const { recurso, numero } = Astro.props;

const tipoLabel: Record<string, string> = {
  pdf: 'PDF',
  enlace: 'Enlace',
  video: 'Vídeo',
  presentacion: 'Presentación',
};
const ctaLabel: Record<string, string> = {
  pdf: 'Abrir PDF',
  enlace: 'Visitar recurso',
  video: 'Ver vídeo',
  presentacion: 'Abrir presentación',
};
const externo = recurso.url?.startsWith('http');
// Los PDF alojados en la web también se abren en una pestaña nueva, para que
// la persona no pierda la página del módulo al consultarlos.
const esPdf = recurso.url?.toLowerCase().endsWith('.pdf');
const nuevaPestana = externo || esPdf;
---
<article class="recurso">
  <span class="num" aria-hidden="true">{numero}</span>
  <div class="tags">
    <span class="badge badge-tipo">{tipoLabel[recurso.tipo]}</span>
  </div>
  <h3>{recurso.titulo}</h3>
  {recurso.fuente && <p class="fuente">{recurso.fuente}</p>}
  {recurso.descripcion && <p>{recurso.descripcion}</p>}
  {recurso.porque && (
    <div class="porque">
      <strong>¿Por qué este recurso?</strong> {recurso.porque}
    </div>
  )}
  {recurso.url && (
    <a
      class="btn btn-primary"
      href={recurso.url}
      target={nuevaPestana ? '_blank' : undefined}
      rel={nuevaPestana ? 'noopener noreferrer' : undefined}
    >
      {ctaLabel[recurso.tipo]}{externo && <span aria-hidden="true"> ↗</span>}
      {nuevaPestana && <span class="sr-only"> (se abre en una ventana nueva)</span>}
    </a>
  )}
</article>
